// Prisma schema — clean architecture migration of Complisk.
// Fresh database (Prisma Postgres) so we use Prisma-native singular table names
// instead of mirroring Sequelize's auto-pluralized ones.
//
// Datasource is configured in `prisma.config.js` at the project root
// (Prisma 7+ requires the `url` to live in the config file, not here).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────────────────────────────────────────────────────
// Enums
// ───────────────────────────────────────────────────────────────────────────

enum AccountType {
  user
  business
  admin
}

enum UserStatus {
  active
  inactive
  blocked
  suspended
}

enum BusinessType {
  small
  medium
  large
  online_ecommerce @map("online-ecommerce")
}

enum BusinessStatus {
  active
  inactive
  blocked
  suspended
}

enum SubscriptionStatus {
  active
  expired
  canceled
  none
}

enum PromotionStatus {
  active
  inactive
  pending
  expired
}

enum PaymentStatus {
  pending
  completed
  failed
}

enum BusinessSubscriptionStatus {
  active
  expired
  canceled
}

enum SubscriptionHistoryStatus {
  active
  expired
  canceled
}

// ───────────────────────────────────────────────────────────────────────────
// Models
// ───────────────────────────────────────────────────────────────────────────

model User {
  id           String      @id @default(uuid()) @db.Uuid
  fullName     String
  email        String      @unique
  password     String
  wishlist     String[]    @default([]) @db.Uuid
  roleId       String?     @db.Uuid
  accountType  AccountType @default(user)
  isSuperAdmin Boolean     @default(false)
  status       UserStatus  @default(active)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  role         Role?       @relation(fields: [roleId], references: [id])

  @@index([email])
  @@index([accountType])
}

model Business {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  email                 String                 @unique
  password              String
  phone                 String
  businessType          BusinessType           @default(small)
  categories            Json                   @default("[]")
  personName            String?
  businessAddress       String?
  state                 String?
  autoApprovePromotions Boolean                @default(false)
  status                BusinessStatus         @default(active)
  subscriptionStatus    SubscriptionStatus     @default(none)
  subscriptionStart     DateTime?
  subscriptionEnd       DateTime?
  stripeSubscriptionId  String?
  stripeCustomerId      String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  promotions            Promotion[]
  subscriptions         BusinessSubscription[]

  @@index([email])
  @@index([status])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  permissions Json     @default("{}")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
}

model Template {
  id                 String      @id @default(uuid()) @db.Uuid
  name               String
  defaultImageUrl    String?
  imageUrl           String?
  cloudinaryPublicId String?
  isDefault          Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  promotions         Promotion[]
}

model Promotion {
  id               String          @id @default(uuid()) @db.Uuid
  businessId       String          @db.Uuid
  templateId       String?         @db.Uuid
  imageUrl         String
  text             Json            @default("[]")
  backgroundColor  String          @default("")
  category         String?
  cities           Json            @default("[]")
  states           Json            @default("[]")
  runDate          DateTime        @db.Date
  stopDate         DateTime        @db.Date
  runTime          DateTime        @db.Time(6)
  stopTime         DateTime        @db.Time(6)
  calculatedMonths Int             @default(1)
  timezones        Json            @default("[]")
  price            Decimal         @db.Decimal(10, 2)
  status           PromotionStatus @default(pending)
  autoApprove      Boolean         @default(false)
  approvedAt       DateTime?
  paymentStatus    PaymentStatus   @default(pending)
  views            Int             @default(0)
  clicks           Int             @default(0)
  stripePaymentId  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  business         Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  template         Template?       @relation(fields: [templateId], references: [id])

  @@index([businessId])
  @@index([status])
  @@index([category])
}

model SubscriptionTemplate {
  id             String                 @id @default(uuid()) @db.Uuid
  name           String
  durationMonths Int
  price          Decimal                @db.Decimal(10, 2)
  freeCities     Int                    @default(2)
  freeStates     Int                    @default(0)
  freeTimezones  Int                    @default(0)
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  businessSubscriptions BusinessSubscription[]
}

model BusinessSubscription {
  id                     String                     @id @default(uuid()) @db.Uuid
  businessId             String                     @db.Uuid
  subscriptionTemplateId String                     @db.Uuid
  startDate              DateTime?
  endDate                DateTime?
  freeCities             Int?
  freeStates             Int?
  freeTimezones          Int?
  status                 BusinessSubscriptionStatus @default(active)
  stripeSubscriptionId   String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  business               Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  template               SubscriptionTemplate       @relation(fields: [subscriptionTemplateId], references: [id])

  @@index([businessId])
  @@index([status])
}

model SubscriptionHistory {
  id                   String                    @id @default(uuid()) @db.Uuid
  businessId           String                    @db.Uuid
  stripeSubscriptionId String?
  stripePriceId        String?
  businessType         String?
  months               Int?
  startDate            DateTime?
  endDate              DateTime?
  status               SubscriptionHistoryStatus @default(active)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([businessId])
}
